# FlightGuard AI Environment Configuration Example

APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PROJECT_NAME="FlightGuard AI"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=flightguard
POSTGRES_PASSWORD=flightguard_pass
POSTGRES_DB=flightguard_db
DATABASE_URL=postgresql://flightguard:flightguard_pass@localhost:5432/flightguard_db

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Machine Learning
ML_MODEL_PATH=ml/models/delay_model_v1.joblib

# FlightAware AeroAPI (v4) Live Tracking
AEROAPI_KEY=your_flightaware_aeroapi_key_here
AEROAPI_BASE_URL=https://aeroapi.flightaware.com/aeroapi
AEROAPI_ENABLED=True
