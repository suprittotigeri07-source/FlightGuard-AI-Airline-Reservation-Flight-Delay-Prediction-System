# FlightGuard AI Frontend Environment Configuration

# In local development, leave this commented or set to /api/v1 (proxied by Vite)
# VITE_API_BASE_URL=/api/v1

# In production (e.g., Vercel), set this in Vercel Project Settings -> Environment Variables
# pointing to your deployed backend URL:
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api/v1
